# MediConnect backend — copy to `.env` and customize.
#
# -----------------------------------------------------------------------------
# DATABASE (canonical default: MongoDB for all Django-managed data)
# -----------------------------------------------------------------------------
# REQUIRED for normal runs: connection string parsed by pymongo/django-mongodb-backend.
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/dbname

# Explicitly keep Django on Mongo for `default` (recommended). Only set `true` for SQLite/Postgres-only dev.
USE_SQL_BACKEND=false

# Override database name embedded in URI (optional).
# MONGODB_DB_NAME=pharmacybackend

# SQL-only fallback (SQLite or DATABASE_URL Postgres). Omit in production MediConnect installs.
# USE_SQL_BACKEND=true

# Explicitly disable mongo stack without USE_SQL_BACKEND (opt-out from URI-based auto-detect).
# DJANGO_USE_MONGODB=false

# Read-only SQLite for one-off migrations into Mongo (`import_sqlite_to_mongodb`).
# LEGACY_SQLITE_PATH=db.sqlite3

SECRET_KEY=django-insecure-change-this-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Apps & integrations (optional — see docs/BACKEND.md)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# Gemini (google-generativeai): avoid gemini-1.5-* for generateContent/v1beta (often HTTP 404).
# Defaults in code map 1.5 IDs to gemini-2.0-flash and use 2.0 as fallback.
# Free tier showing "limit: 0" / 429 requires billing enabled or switching models — see ai.google.dev rate limits.
# GEMINI_VISION_MODEL=gemini-2.0-flash
# Comma-separated fallbacks tried on quota/404 when unset: 2.5-flash-lite, 2.5-flash, 2.0-flash-lite
# GEMINI_VISION_MODEL_FALLBACK=gemini-2.5-flash-lite,gemini-2.5-flash
# GEMINI_CHAT_MODEL=gemini-2.0-flash
